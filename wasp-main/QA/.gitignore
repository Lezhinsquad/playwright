# Playwright 실행 시 생성되는 캐시 및 다운로드 폴더
QA/.playwright-cache/
QA/.playwright-report/
QA/.pytest_cache/
QA/test-results/
QA/report/

# Playwright 실행 중 생성되는 파일
QA/report.html
QA/tests/report.html
QA/test-results/
QA/traces/
QA/screenshots/
QA/videos/
QA/tests/*.log
QA/debug.log  # Playwright 디버그 로그

# Playwright 특정 실행 결과 파일
QA/output/
QA/results/
QA/logs/


# Python 가상환경 (venv) 폴더
venv/
.QA-venv/

# Python 컴파일된 캐시 파일 (__pycache__)
__pycache__/
QA/__pycache__/
QA/tests/__pycache__/
QA/tests/QA_tests/__pycache__/
QA/utils/__pycache__/
QA/etc/__pycache__/
*.pyc
*.pyo
*.pyd

# 환경 변수 파일 (보안 정보 포함 가능)
.env
.env.local
.env.production
.env.development

# pytest 환경 설정 파일
pytest.ini
wasp/pytest.ini

# GitLab CI/CD 관련
.gitlab-ci.yml.swp  # Vim 편집 중 생성되는 파일 방지

# 테스트 파일
QA/tests/test_Real_SNS_Login.py
QA/tests/test_Real_SNSLogin_ErrorHandling.py
QA/tests/test_Real_Account.py
QA/tests/QA_tests/*.py
QA/etc
QA/etc/*.py
QA/etc/*.*
QA/etc/**/*.py
QA/config/accounts.json